# =====================================================
# Coderr Backend Environment Template
# Django + Docker
# =====================================================


# =====================================================
# Django Security
# =====================================================

# Generate a new secret key for production
# Example:
# SECRET_KEY=my-long-random-secret-key

SECRET_KEY=change-me


# =====================================================
# Django Debug Mode
# =====================================================

# Development:
# DEBUG=True

# Production:
# DEBUG=False

DEBUG=True


# =====================================================
# Allowed Hosts
# =====================================================

# Local development:
ALLOWED_HOSTS=127.0.0.1,localhost


# Production example:
# ALLOWED_HOSTS=coderr.frank-meckel.de


# =====================================================
# Database
# =====================================================

# SQLite database file
# The file itself is ignored by Git

DATABASE_NAME=db.sqlite3


# =====================================================
# CORS Configuration
# =====================================================

# Development frontend:
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# Production example:
# CORS_ALLOWED_ORIGINS=https://coderr.frank-meckel.de